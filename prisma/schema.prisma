generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String    @id @default(uuid())
  name               String
  vocml_license_key  String?
  license_expired_at DateTime?
  tax_enabled        Boolean   @default(true)
  tax_rate           Float     @default(11)
  rounding_unit      Int       @default(0)
  invoice_header     String?
  invoice_footer     String?
  app_logo           String?
  created_at         DateTime  @default(now())

  users             User[]
  products          Product[]
  categories        Category[]
  transactions      Transaction[]
  stockTransactions StockTransaction[]
  customers         Customer[]
  suppliers         Supplier[]

  @@map("tenants")
}

model Customer {
  id        String   @id @default(uuid())
  tenant_id String
  name      String
  phone     String?
  address   String?

  tenant    Tenant   @relation(fields: [tenant_id], references: [id])
  
  @@map("customers")
}

model Supplier {
  id                String   @id @default(uuid())
  tenant_id         String
  name              String
  contact           String?
  phone             String?
  payment_term_days Int      @default(0)

  tenant    Tenant   @relation(fields: [tenant_id], references: [id])

  @@map("suppliers")
}

model User {
  id            String   @id @default(uuid())
  tenant_id     String
  username      String
  password_hash String
  role          String   @default("cashier")
  created_at    DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("users")
}

model Category {
  id        String @id @default(uuid())
  tenant_id String
  name      String

  tenant   Tenant    @relation(fields: [tenant_id], references: [id])
  products Product[]

  @@map("categories")
}

model Product {
  id             String  @id @default(uuid())
  tenant_id      String
  sku            String?
  barcode        String?
  name           String
  category_id    String?
  purchase_price Float   @default(0)
  selling_price  Float   @default(0)
  wholesale_price Float  @default(0)
  stock          Int     @default(0)
  min_stock      Int     @default(0)
  image_url      String?

  tenant               Tenant                 @relation(fields: [tenant_id], references: [id])
  category             Category?              @relation(fields: [category_id], references: [id])
  transactionItems     TransactionItem[]
  stockTransactionItems StockTransactionItem[]

  @@map("products")
}

model Transaction {
  id             String   @id @default(uuid())
  tenant_id      String
  cashier_id     String
  cashier_name   String?
  receipt_number String
  total_amount   Float
  payment_method String
  created_at     DateTime @default(now())

  tenant Tenant            @relation(fields: [tenant_id], references: [id])
  items  TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id             String @id @default(uuid())
  transaction_id String
  product_id     String
  quantity       Int
  price_at_time  Float
  subtotal       Float

  transaction Transaction @relation(fields: [transaction_id], references: [id])
  product     Product     @relation(fields: [product_id], references: [id])

  @@map("transaction_items")
}

model StockTransaction {
  id           String   @id @default(uuid())
  tenant_id    String
  type         String   // "IN", "OUT", "ADJUSTMENT"
  date         DateTime @default(now())
  document_no  String
  supplier_id  String?
  employee_id  String
  total_value  Float
  note         String?
  customer_id  String?
  customer_name String?

  tenant Tenant                 @relation(fields: [tenant_id], references: [id])
  items  StockTransactionItem[]

  @@map("stock_transactions")
}

model StockTransactionItem {
  id                  String @id @default(uuid())
  stock_transaction_id String
  product_id          String
  qty                 Int
  batch_no            String?
  expiry_date         String?
  purchase_price      Float
  subtotal            Float

  stockTransaction StockTransaction @relation(fields: [stock_transaction_id], references: [id])
  product          Product          @relation(fields: [product_id], references: [id])

  @@map("stock_transaction_items")
}
