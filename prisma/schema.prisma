generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String    @id @default(uuid())
  name               String
  vocml_license_key  String?
  license_expired_at DateTime?
  tax_enabled        Boolean   @default(true)
  tax_rate           Float     @default(11)
  rounding_unit      Int       @default(0)
  invoice_header     String?
  invoice_footer     String?
  app_logo           String?
  created_at         DateTime  @default(now())

  users             User[]
  products          Product[]
  categories        Category[]
  transactions      Transaction[]
  stockTransactions StockTransaction[]
  customers         Customer[]
  suppliers         Supplier[]
  supplierPayments  SupplierPayment[]

  @@map("tenants")
}

model Customer {
  id        String   @id @default(uuid())
  tenant_id String
  name      String
  phone     String?
  address   String?

  tenant    Tenant   @relation(fields: [tenant_id], references: [id])
  
  @@map("customers")
}

model Supplier {
  id                String   @id @default(uuid())
  tenant_id         String
  name              String
  contact           String?
  phone             String?
  payment_term_days Int      @default(0)
  payable           Float    @default(0) // Total debt to this supplier

  tenant    Tenant   @relation(fields: [tenant_id], references: [id])
  payments  SupplierPayment[]

  @@map("suppliers")
}

model SupplierPayment {
  id          String   @id @default(uuid())
  tenant_id   String
  supplier_id String
  amount      Float
  payment_method String @default("CASH")
  note        String?
  created_at  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  supplier Supplier @relation(fields: [supplier_id], references: [id])

  @@map("supplier_payments")
}

model User {
  id            String   @id @default(uuid())
  tenant_id     String
  name          String?  // Added for Employee migration
  username      String
  password_hash String
  pin           String?  // Added for PIN login
  role          String   @default("cashier")
  is_active     Boolean  @default(true) // Added to match isActive
  shift         String   @default("A") // Shift kerja: A (Pagi), B (Siang), C (Malam), AUTO (ikut jam)
  created_at    DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("users")
}

model Draft {
  id        String @id @default(uuid())
  tenant_id String
  key       String
  value     String // JSON string
  
  @@unique([tenant_id, key])
  @@map("drafts")
}

model Category {
  id        String @id @default(uuid())
  tenant_id String
  name      String

  tenant   Tenant    @relation(fields: [tenant_id], references: [id])
  products Product[]

  @@map("categories")
}

model Product {
  id             String  @id @default(uuid())
  tenant_id      String
  sku            String?
  barcode        String?
  name           String
  category_id    String?
  purchase_price Float   @default(0)
  selling_price  Float   @default(0)
  wholesale_price Float  @default(0)
  min_wholesale_qty Float? @default(0) // Minimum qty pembelian agar dapat harga grosir
  stock          Float   @default(0)
  min_stock      Float   @default(0)
  unit           String  @default("Pcs") // satuan jual (Pcs, Kg, Gram, Liter, ...). Harga selalu per satuan ini.
  image_url      String?
  is_active      Boolean @default(true) // false = disembunyikan dari Kasir POS (mis. stok habis mendadak)
  deleted_at     DateTime? // soft delete: produk yang sudah punya riwayat tidak dihapus fisik agar laporan/invoice/mutasi tetap utuh

  tenant               Tenant                 @relation(fields: [tenant_id], references: [id])
  category             Category?              @relation(fields: [category_id], references: [id])
  transactionItems     TransactionItem[]
  stockTransactionItems StockTransactionItem[]
  variants             ProductVariant[]
  salesReturnItems     SalesReturnItem[]

  @@map("products")
}

// Varian produk (mis. warna/rasa). Stok dicatat per varian; Product.stock = total seluruh varian.
// Harga bernilai null = ikut harga produk induk.
model ProductVariant {
  id              String   @id @default(uuid())
  tenant_id       String
  product_id      String
  name            String
  barcode         String?
  sku             String?
  image_url       String?
  stock           Float    @default(0)
  purchase_price  Float?
  selling_price   Float?
  wholesale_price Float?
  min_wholesale_qty Float? @default(0)
  created_at      DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([barcode])
  @@map("product_variants")
}

model Transaction {
  id             String   @id @default(uuid())
  tenant_id      String
  cashier_id     String
  cashier_name   String?
  receipt_number String
  total_amount   Float
  payment_method String
  customer_id    String?
  customer_name  String?
  created_at     DateTime @default(now())
  status         String   @default("COMPLETED") // COMPLETED, VOID
  payment_status String   @default("PAID") // PAID, PARTIAL, UNPAID
  paid_amount    Float    @default(0)
  due_date       DateTime?
  notes          String?

  tenant   Tenant               @relation(fields: [tenant_id], references: [id])
  items    TransactionItem[]
  payments TransactionPayment[]
  returns  SalesReturn[]

  @@map("transactions")
}

model TransactionItem {
  id                String   @id @default(uuid())
  transaction_id    String
  product_id        String
  quantity          Float
  price_at_time     Float
  subtotal          Float
  variant_id        String?
  variant_name      String?
  original_price    Float?
  is_custom_price   Boolean? @default(false)
  custom_price_note String?

  transaction Transaction @relation(fields: [transaction_id], references: [id])
  product     Product     @relation(fields: [product_id], references: [id])

  @@map("transaction_items")
}

model StockTransaction {
  id           String   @id @default(uuid())
  tenant_id    String
  type         String   // "IN", "OUT", "ADJUSTMENT"
  date         DateTime @default(now())
  document_no  String
  supplier_id  String?
  employee_id  String
  total_value  Float
  note         String?
  customer_id  String?
  customer_name String?
  on_credit    Boolean  @default(true) // IN dari supplier: true = menambah hutang (tempo), false = tunai/lunas

  tenant Tenant                 @relation(fields: [tenant_id], references: [id])
  items  StockTransactionItem[]

  @@map("stock_transactions")
}

model StockTransactionItem {
  id                  String @id @default(uuid())
  stock_transaction_id String
  product_id          String
  qty                 Float
  batch_no            String?
  expiry_date         String?
  purchase_price      Float
  subtotal            Float
  variant_id          String?
  variant_name        String?

  stockTransaction StockTransaction @relation(fields: [stock_transaction_id], references: [id])
  product          Product          @relation(fields: [product_id], references: [id])

  @@map("stock_transaction_items")
}

model TransactionPayment {
  id             String   @id @default(uuid())
  tenant_id      String
  transaction_id String
  amount         Float
  payment_method String   @default("TUNAI")
  payment_date   DateTime @default(now())
  cashier_id     String?
  cashier_name   String?
  note           String?

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@map("transaction_payments")
}

model SalesReturn {
  id             String   @id @default(uuid())
  tenant_id      String
  transaction_id String
  return_number  String
  total_refund   Float
  refund_method  String   @default("CASH") // CASH, POTONG_PIUTANG
  reason         String?
  created_at     DateTime @default(now())
  employee_id    String?
  employee_name  String?

  transaction Transaction       @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  items       SalesReturnItem[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id              String  @id @default(uuid())
  sales_return_id String
  product_id      String
  variant_id      String?
  variant_name    String?
  quantity        Float
  refund_price    Float
  subtotal        Float
  return_to_stock Boolean @default(true) // true = stok fisik bertambah lagi, false = rusak/afkir

  salesReturn SalesReturn @relation(fields: [sales_return_id], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [product_id], references: [id])

  @@map("sales_return_items")
}

